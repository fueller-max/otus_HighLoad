

Kubernetes Secrets + initContainer



```yaml
#wordpress-rbac.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: vault-sync-sa
  namespace: wordpress
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: vault-sync-role
  namespace: wordpress
rules:
- apiGroups: [""]
  resources: ["secrets"]
  verbs: ["get", "patch", "create", "update"]
- apiGroups: ["apps"]
  resources: ["deployments"]
  verbs: ["patch", "get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: vault-sync-binding
  namespace: wordpress
subjects:
- kind: ServiceAccount
  name: vault-sync-sa
  namespace: wordpress
roleRef:
  kind: Role
  name: vault-sync-role
  apiGroup: rbac.authorization.k8s.io
```


Vault

```bash
# Создаём роль с правами только на чтение конкретного пути
vault write auth/approle/role/wordpress-sync \
  secret_id_ttl=240h \
  token_ttl=48h \
  token_max_ttl=48h \
  policies="wordpress-read"

# Получаем SecretID (нужен для генерации токена, но в твоём случае лучше сразу получить токен)
# ВАЖНО: Для CronJob с curl проще всего получить сразу токен, а не SecretID/RoleID
vault token create -policy="wordpress-read" -ttl=72h

```

```bash
Key                  Value
---                  -----
token                *****
token_accessor       Gxx9i2VzH7CK4ICDma8kYFeg
token_duration       72h
token_renewable      true
token_policies       ["default" "wordpress-read"]
identity_policies    []
policies             ["default" "wordpress-read"]
```

Получаем роль iD  

```bash
/ # vault read auth/approle/role/wordpress-sync/role-id
Key        Value
---        -----
role_id    d8638246-8d5e-918f-0c6d-0b6180f86e4b
```

Кладем токен в secret Kubernetes

```bash

kubectl create secret generic vault-sync-token \
  -n wordpress \
  --from-literal=token="*******o"

```

##############

```yaml
#cron-wordpress.yaml

apiVersion: batch/v1
kind: CronJob
metadata:
  name: vault-wordpress-sync
  namespace: wordpress
spec:
  schedule: "*/2 * * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      template:
        spec:
          serviceAccountName: vault-sync-sa
          restartPolicy: Never
          imagePullSecrets:
            - name: regcred
          containers:
          - name: syncer
            image: 192.168.70.156:5000/vault-sync-tool:1.0
            imagePullPolicy: IfNotPresent
            command: ["sh", "-c"]
            args:
            - |
              set -euo pipefail

              VAULT_ADDR="http://vault-internal.vault.svc.cluster.local:8200"
              SECRET_PATH="secret/data/wordpress/db"
              K8S_SECRET_NAME="wp-db-credentials"
              DEPLOYMENT_NAME="wordpress"
              NAMESPACE="wordpress"

              # Получаем токен из секрета
              VAULT_TOKEN=$(kubectl get secret vault-sync-token -n "$NAMESPACE" -o jsonpath="{.data.token}" | base64 -d)

              RESPONSE=$(curl -s -H "X-Vault-Token: $VAULT_TOKEN" "$VAULT_ADDR/v1/$SECRET_PATH")

              if echo "$RESPONSE" | grep -q '"errors"'; then
                echo "Vault error: $RESPONSE"
                exit 1
              fi

              DB_USER=$(echo "$RESPONSE" | jq -r '.data.data.username // empty')
              DB_PASS=$(echo "$RESPONSE" | jq -r '.data.data.password // empty')

              if [ -z "$DB_USER" ] || [ -z "$DB_PASS" ]; then
                echo "ERROR: Could not extract credentials from Vault"
                exit 1
              fi

              kubectl patch secret "$K8S_SECRET_NAME" -n "$NAMESPACE" --type=merge -p "{
                \"data\": {
                  \"db_user\": \"$(echo -n "$DB_USER" | base64 -w0)\",
                  \"db_pass\": \"$(echo -n "$DB_PASS" | base64 -w0)\"
                }
              }" || \
              kubectl create secret generic "$K8S_SECRET_NAME" -n "$NAMESPACE" \
                --from-literal=db_user="$DB_USER" \
                --from-literal=db_pass="$DB_PASS"

              echo "Secret updated. Restarting WordPress deployment..."
              kubectl rollout restart deployment "$DEPLOYMENT_NAME" -n "$NAMESPACE"

```

Сам деплой wordpress

```yaml
#wordpress-app.yaml
apiVersion: v1
kind: Service
metadata:
  name: wordpress
  labels:
    app: wordpress
spec:
  ports:
    - port: 80
  selector:
    app: wordpress
    tier: frontend
  type: LoadBalancer
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: wordpress
  namespace: wordpress
  labels:
    app: wordpress
spec:
  replicas: 1
  selector:
    matchLabels:
      app: wordpress
  template:
    metadata:
      labels:
        app: wordpress
    spec:
      containers:
      - name: wordpress
        image: wordpress:6.5-apache
        # Подтягиваем ВСЕ ключи из секрета wp-db-credentials как переменные окружения
        envFrom:
        - secretRef:
            name: wp-db-credentials
        # Фиксированные переменные, которые не лежат в секрете
        env:
        - name: WORDPRESS_DB_HOST
          value: "mysql-service.mysql.svc.cluster.local"
        - name: WORDPRESS_DB_NAME
          value: "wordpress"
        # WORDPRESS_DB_USER и WORDPRESS_DB_PASSWORD берутся из секрета через envFrom
        ports:
        - containerPort: 80
        resources:
          requests:
            memory: "128Mi"
            cpu: "100m"
          limits:
            memory: "512Mi"
            cpu: "500m"
      restartPolicy: Always
```

```yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: wordpress
  labels:
    app: wordpress
spec:
  selector:
    matchLabels:
      app: wordpress
      tier: frontend
  template:
    metadata:
      labels:
        app: wordpress
        tier: frontend
  spec:
    containers:
    - image: wordpress:latest
      name: wordpress
      env:
      - name: WORDPRESS_DB_HOST
        value: wordpress-mysql:3306
      - name: WORDPRESS_DB_PASSWORD
        valueFrom:
          secretKeyRef:
            name: mysql-pass
            key: password
      - name: WORDPRESS_DB_USER
        value: root
      ports:
      - containerPort: 80
        name: wordpress
---
apiVersion: v1
kind: Service
metadata:
  name: wordpress-mysql
  labels:
    app: wordpress
spec:
  ports:
    - port: 3306
  selector:
    app: wordpress
    tier: mysql
  clusterIP: None
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: wordpress-mysql
  labels:
    app: wordpress
spec:
  selector:
    matchLabels:
      app: wordpress
      tier: mysql
  template:
    metadata:
      labels:
        app: wordpress
        tier: mysql
  spec:
    containers:
    - image: mysql:8.0
      name: mysql
      env:
      - name: MYSQL_ROOT_PASSWORD
        valueFrom:
          secretKeyRef:
            name: mysql-pass
            key: password
      ports:
      - containerPort: 3306
        name: mysql
```

```yaml
apiVersion: v1
kind: Secret
metadata:
  name: mysql-pass
type: Opaque
stringData:
  # Replace with a strong password of your choice
  password: SuperSecurePassword123!
```    